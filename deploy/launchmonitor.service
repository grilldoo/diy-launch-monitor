# Start the launch monitor at boot. Install (on the Pi, as user "golf"; adjust paths/user):
#   sudo cp deploy/launchmonitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now launchmonitor
#   journalctl -u launchmonitor -f        # watch shots
[Unit]
Description=DIY launch monitor
After=network-online.target
Wants=network-online.target

[Service]
User=golf
WorkingDirectory=/home/golf/diy-launch-monitor
# Set GSPro's PC address here:
ExecStart=/home/golf/diy-launch-monitor/.venv/bin/python -m launchmonitor run --gspro 192.168.1.50
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
